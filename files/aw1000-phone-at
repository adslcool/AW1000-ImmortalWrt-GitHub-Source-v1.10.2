#!/bin/sh
# All telephone AT traffic shares QModem's owner and command queue.
set -eu
[ "$#" = 2 ] || exit 2
suffix=${1#/dev/ttyUSB}
[ "$suffix" != "$1" ] || exit 2
case "$suffix" in ''|*[!0-9]*) exit 2;; esac
payload=$(jq -cn --arg port "$1" --arg cmd "$2" \
    '{at_port:$port,at_cmd:$cmd,timeout:3,owner:"aw1000-phone"}')
reply=$(ubus -t 5 call at-daemon sendat "$payload") || exit 1
printf '%s\n' "$reply" | jq -er 'select(.status == "success") | .response'
