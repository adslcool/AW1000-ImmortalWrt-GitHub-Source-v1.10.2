#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = arcadyan,aw1000 ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/aw1000-mwan-follow
    procd_set_param respawn
    procd_close_instance
    procd_open_instance sim
    procd_set_param command /usr/sbin/aw1000-internet --monitor
    procd_set_param respawn
    procd_close_instance
}
service_stopped() {
    /usr/sbin/aw1000-mwan-follow --restore
}
