config globals 'globals'
    option mmx_mask '0x00ff0000'
    option aw1000_enabled '1'

config interface 'wan'
    option enabled '1'
    option initial_state 'offline'
    option family 'ipv4'
    option track_method 'ping'
    list track_ip '223.5.5.5'
    list track_ip '119.29.29.29'
    option reliability '1'
    option count '1'
    option timeout '1'
    option interval '2'
    option failure_interval '2'
    option recovery_interval '2'
    option down '2'
    option up '15'

config member 'aw_wired'
    option interface 'wan'
    option metric '1'
    option weight '1'

config member 'aw_cell'
    option metric '2'
    option weight '1'

config policy 'aw_failover'
    list use_member 'aw_wired'
    option last_resort 'unreachable'

config rule 'aw_default'
    option family 'ipv4'
    option dest_ip '0.0.0.0/0'
    option use_policy 'aw_failover'
