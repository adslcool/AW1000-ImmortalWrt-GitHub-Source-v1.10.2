# Arcadyan AW1000 / IPQ8072A. Keep the target's board firmware and Wi-Fi defaults.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# LuCI, HTTPS, Chinese, Argon. No Argon configuration application.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-aw1000-internet-zh-cn=y
CONFIG_BUSYBOX_CONFIG_PASSWD=y

# QModem's current JavaScript UI includes the modem core and SMS dependencies.
CONFIG_PACKAGE_luci-app-qmodem-next=y
# CONFIG_PACKAGE_luci-app-qmodem is not set
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_qmodem_INCLUDE_SEAL=y
CONFIG_PACKAGE_qmodem_INCLUDE_ndisc6=y
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
# CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan is not set
# CONFIG_PACKAGE_qmodem_INCLUDE_nss-qmi-wwan is not set
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_PCI_SUPPORT is not set
CONFIG_PACKAGE_qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
CONFIG_PACKAGE_quectel-CM-5G-M=y
CONFIG_PACKAGE_qmodem-smsd=y
CONFIG_PACKAGE_sms-forwarder-next=y
CONFIG_PACKAGE_ubus-at-daemon=y
CONFIG_PACKAGE_qmodem-settings=y
CONFIG_PACKAGE_modem_scan=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_sms-tool_q=y

# mwan3-nft owns failover; QModem keeps the cellular PDP up.
# CONFIG_PACKAGE_luci-app-qmodem-uplink is not set
# CONFIG_PACKAGE_qmodem-uplink-manager is not set
CONFIG_PACKAGE_luci-app-qmodem-monitor=y
CONFIG_PACKAGE_qmodem_monitor=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_nftables-json=y
# QModem uplink uses jq test()/match(); the default jq variant has no regex.
CONFIG_PACKAGE_jq-full=y
# CONFIG_PACKAGE_jq is not set
CONFIG_PACKAGE_oniguruma=y
# CONFIG_PACKAGE_nftables-nojson is not set
# CONFIG_PACKAGE_luci-app-qmodem-mwan is not set
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# AW1000's internal RG500Q-EA is connected over USB. No unrelated PCIe drivers.
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_usbutils=y

# SSR Plus+ with the native firewall4 backend and working proxy cores.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Mihomo=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_GeoData=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Http_Proxy is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client is not set

CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-vsftpd=y
CONFIG_PACKAGE_vsftpd=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-zerotier=y

# Mount points and Scheduled Tasks are provided by luci-mod-system.
CONFIG_PACKAGE_block-mount=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_CROND=y
CONFIG_BUSYBOX_CONFIG_CRONTAB=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ca-bundle=y

# USB printer sharing (RAW TCP 9100).
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
# CONFIG_PACKAGE_luci-app-aw1k-led is not set

# RJ11: build the driver against this firmware kernel, not a foreign APK.
CONFIG_PACKAGE_kmod-aw1000-fxs=y
CONFIG_PACKAGE_fxsd=y
CONFIG_PACKAGE_luci-app-fxs=y

# Dual-stack addressing; IPv6 follows the IPv4-selected uplink.
CONFIG_IPV6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
# CONFIG_PACKAGE_odhcpd is not set
CONFIG_PACKAGE_luci-proto-ipv6=y

# IPv6 no-PD fallback uses the existing nft NAT kernel infrastructure.
CONFIG_PACKAGE_kmod-nft-nat=y

# Internet settings: explicit PPPoE support for wired WAN.
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# Rear WLAN/WPS buttons and recurring benchmark.
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=4
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_unzip=y
CONFIG_BUSYBOX_CONFIG_NICE=y

# IPTV/DLNA server with local LuCI administration.
CONFIG_PACKAGE_xupnpd=y
CONFIG_PACKAGE_luci-app-xupnpd=y
